---
import { ClientRouter } from "astro:transitions";
import { cn } from "@/lib/utils";

import HeadSEO from "@/components/HeadSEO.astro";
import { Header } from "@/components/Header";
import { Footer } from "@/components/Footer";

const { title, description, ogImage, type, pubDate, author, tags, hideHeader = false, hideFooter = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <HeadSEO title={title} description={description} ogImage={ogImage} type={type} pubDate={pubDate} author={author} tags={tags} />
    <ClientRouter />
  </head>
  <body
    class={cn(
      "group/body overscroll-none antialiased [--footer-height:calc(var(--spacing)*14)] [--header-height:calc(var(--spacing)*14)] xl:[--footer-height:calc(var(--spacing)*24)]",
    )}
  >
    <div class="bg-background relative z-10 flex min-h-svh flex-col">
      {!hideHeader && <Header client:idle transition:persist />}
      <main class="flex flex-1 flex-col">
        <slot />
      </main>
      {!hideFooter && <Footer />}
    </div>
  </body>
</html>
