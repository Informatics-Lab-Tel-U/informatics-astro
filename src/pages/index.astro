---
import LandingPage from "@/components/LandingPage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/lib/config";
import { getPosts } from "@/lib/api/blog";

const { data: recentPosts } = await getPosts({ limit: 3 });

const BACKEND_URL = import.meta.env.PUBLIC_HONO_BACKEND_URL || "https://manajemenasprak-backend.iflabdev.workers.dev";
let heroImages = [
  { id: 'default-1', image: '/backgrounds/bg-1.jpeg', alt: 'Informatics Laboratory Hero Showcase', title: 'Informatics Laboratory' }
];
let heroTitles = ['Informatics Laboratory'];

try {
  const [imagesRes, titlesRes] = await Promise.all([
    fetch(`${BACKEND_URL}/api/web-config/hero_images`),
    fetch(`${BACKEND_URL}/api/web-config/hero_titles`)
  ]);

  if (imagesRes.ok) {
    const json = await imagesRes.json();
    if (json.ok && Array.isArray(json.data) && json.data.length > 0) {
      heroImages = json.data;
    }
  }

  if (titlesRes.ok) {
    const json = await titlesRes.json();
    if (json.ok && Array.isArray(json.data) && json.data.length > 0) {
      heroTitles = json.data;
    }
  }
} catch {
  // Silent fallback to local default
}
---

<BaseLayout
  title={siteConfig.name}
  description={siteConfig.description}
>
  <LandingPage recentPosts={recentPosts} heroImages={heroImages} heroTitles={heroTitles} />
</BaseLayout>
