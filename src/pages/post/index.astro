---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PostsSection } from "@/components/PostsSection";
import { getPosts, getCategories, getTags } from "@/lib/api";

// Fetch posts during build time (SSG)
const posts = await getPosts();
const categories = await getCategories();
const tags = await getTags();
---

<BaseLayout
  title="Post & Pengumuman | Laboratorium Informatika"
  description="Kumpulan berita, pengumuman, dan artikel terbaru dari Laboratorium Informatika Telkom University."
>
  <div class="container mx-auto max-w-7xl px-4 sm:px-6 py-12 md:py-20">
    <div class="mb-12">
      <h1
        class="text-4xl md:text-5xl font-bold tracking-tight mb-4 text-foreground"
      >
        Post & Pengumuman
      </h1>
      <p class="text-lg text-muted-foreground max-w-2xl">
        Kumpulan berita, pengumuman, dan artikel riset terbaru dari Laboratorium
        Informatika.
      </p>
    </div>

    <PostsSection posts={posts} categories={categories} tags={tags} client:load />
  </div>
</BaseLayout>
