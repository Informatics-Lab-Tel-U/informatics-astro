---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts, getPostBySlug, getPostsByCategory } from "@/lib/api";
import { BlogCard } from "@/components/BlogCard";
import { Badge } from "@/components/ui/badge";
import { ArrowLeft } from "lucide-react";
import { Button } from "@/components/ui/button";
import { renderToHTMLString } from '@tiptap/static-renderer/pm/html-string';
import StarterKit from '@tiptap/starter-kit';
import Image from '@tiptap/extension-image';
import { AttachmentNode } from '@/lib/tiptap-attachment';
import { normalizeTiptapContent } from '@/lib/tiptap-utils';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

const post = await getPostBySlug(slug);

if (!post) {
  return Astro.redirect('/404');
}

let parsedContent = '';
try {
  const rawContent = typeof post.content === 'string' ? JSON.parse(post.content) : post.content;
  const jsonContent = normalizeTiptapContent(rawContent);
  parsedContent = renderToHTMLString({
    extensions: [
      StarterKit.configure({
        link: {
          openOnClick: true,
          autolink: true,
          HTMLAttributes: {
            target: '_blank',
            rel: 'noopener noreferrer',
            class: 'text-primary underline hover:text-primary/80 cursor-pointer',
          },
        },
      }),
      AttachmentNode,
      Image.configure({
        HTMLAttributes: {
          class: 'rounded-lg border object-cover my-6 mx-auto max-h-[600px]',
        },
      }),
    ],
    content: jsonContent,
    options: {
      unhandledNode: ({ node }) => `<!-- unhandled node: ${node.type.name} -->`,
      unhandledMark: ({ mark }) => `<!-- unhandled mark: ${mark.type.name} -->`,
    }
  });
} catch (e) {
  console.error("Error parsing HTML:", e);
  parsedContent = '<p class="text-destructive font-semibold">Konten tidak dapat dimuat (Format tidak valid).</p>';
}

const formattedDate = new Date(post.pubDate).toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});

const relatedPostsRaw = await getPostsByCategory(post.category.slug);
const relatedPosts = relatedPostsRaw.filter(p => p.slug !== post.slug).slice(0, 2);
---

<BaseLayout
  title={`${post.title} | Post Laboratorium Informatika`}
  description={post.description}
  ogImage={post.heroImage || "/default-image.svg"}
>
  <article class="container mx-auto max-w-4xl px-4 sm:px-6 py-12 md:py-20">
    <div class="mb-10">
      <a href="/post">
        <Button variant="outline" className="mb-8 px-6 font-semibold">
          <ArrowLeft className="w-4 h-4 mr-2" />
          Kembali ke Post
        </Button>
      </a>

      <div class="flex flex-wrap items-center gap-3 mb-6">
        <Badge variant="secondary" className="rounded-md px-3 py-1 font-medium">{post.category.name}</Badge>
        <span class="text-sm text-muted-foreground">&bull;</span>
        <time class="text-sm text-muted-foreground">{formattedDate}</time>
        <span class="text-sm text-muted-foreground">&bull;</span>
        <span class="text-sm text-muted-foreground">Oleh {post.author}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tighter leading-tight text-foreground mb-6">
        {post.title}
      </h1>
      
      <p class="text-xl text-muted-foreground leading-relaxed mb-8">
        {post.description}
      </p>
    </div>

    <div class="w-full aspect-video max-h-[500px] overflow-hidden rounded-3xl bg-muted border border-border mb-12">
      <img 
        src={post.heroImage || "/default-image.svg"} 
        alt={post.title} 
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover object-center"
      />
    </div>

    {/* Gunakan class 'typeset' yang sudah kita buat sebelumnya untuk Markdown formatting */}
    <div class="typeset typeset-docs max-w-none text-foreground/90 font-medium" set:html={parsedContent}>
    </div>

    <div class="mt-16 pt-8 border-t border-border flex flex-wrap items-center gap-4">
      <span class="font-medium text-foreground">Topik terkait:</span>
      {post.tags.map(tag => (
        <a href={`/tag/${tag.slug}`} class="text-sm font-medium text-muted-foreground bg-muted/50 hover:bg-primary/10 hover:text-primary transition-colors px-3 py-1.5 rounded-md border border-transparent hover:border-primary/20">
          #{tag.name}
        </a>
      ))}
    </div>
    {relatedPosts.length > 0 && (
      <div class="mt-16 pt-8 border-t border-border">
        <h2 class="text-2xl font-bold tracking-tight mb-6 text-foreground">Baca Juga Topik Serupa</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {relatedPosts.map(relatedPost => (
            <BlogCard post={relatedPost} />
          ))}
        </div>
      </div>
    )}
  </article>
</BaseLayout>
