---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogCard from "@/components/BlogCard.astro";
import BlogSidebar from "@/components/BlogSidebar.astro";
import { getPosts, getCategories, getTags } from "@/lib/api";

const { page } = Astro.params;
let currentPage = 1;
if (page) {
  // Hanya terima parameter yang diawali dengan "page/" (contoh: /post/page/2)
  // Ini mencegah bentrok dengan rute [slug].astro yang menangani /post/judul-artikel
  if (page.startsWith('page/')) {
    currentPage = parseInt(page.replace('page/', ''), 10);
  } else {
    // Jika mencoba akses /post/2 langsung atau format lain yang salah
    return Astro.rewrite("/404");
  }
}

if (isNaN(currentPage) || currentPage < 1) {
  return Astro.rewrite("/404");
}

let posts = await getPosts();
const categories = await getCategories();
const tags = await getTags();

const startDate = Astro.url.searchParams.get('startDate');
const endDate = Astro.url.searchParams.get('endDate');

if (startDate) {
  posts = posts.filter(p => new Date(p.pubDate) >= new Date(startDate));
}
if (endDate) {
  // We add 1 day (86400000 ms) to endDate to include the whole day (up to 23:59:59)
  const endOfDay = new Date(new Date(endDate).getTime() + 86400000);
  posts = posts.filter(p => new Date(p.pubDate) < endOfDay);
}

const sortBy = Astro.url.searchParams.get('sort') || 'Terbaru';
if (sortBy === 'Terlama' || sortBy === 'oldest') {
  posts.sort((a, b) => new Date(a.pubDate).getTime() - new Date(b.pubDate).getTime());
} else {
  posts.sort((a, b) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime());
}

const PAGE_SIZE = 10; // 10 posts per page for optimal grid (2x5 on desktop)
const totalPages = Math.ceil(posts.length / PAGE_SIZE);

if (currentPage > totalPages && totalPages > 0) {
  return Astro.rewrite("/404");
}

const startIndex = (currentPage - 1) * PAGE_SIZE;
const paginatedPosts = posts.slice(startIndex, startIndex + PAGE_SIZE);

const search = Astro.url.searchParams.has('sort') ? `?sort=${Astro.url.searchParams.get('sort')}` : '';
const prevPageUrl = currentPage > 1 ? (currentPage === 2 ? `/post${search}` : `/post/page/${currentPage - 1}${search}`) : null;
const nextPageUrl = currentPage < totalPages ? `/post/page/${currentPage + 1}${search}` : null;
---

<BaseLayout
  title={`Post & Pengumuman - Halaman ${currentPage} | Laboratorium Informatika`}
  description="Kumpulan berita, pengumuman, dan artikel terbaru dari Laboratorium Informatika Telkom University."
>
  <div class="container mx-auto max-w-7xl px-4 sm:px-6 py-12 md:py-20">
    <div class="mb-12">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4 text-foreground">
        Post & Pengumuman
      </h1>
      <p class="text-lg text-muted-foreground max-w-2xl">
        Kumpulan berita, pengumuman, dan artikel riset terbaru dari Laboratorium
        Informatika.
      </p>
    </div>

    <div class="flex flex-col lg:flex-row gap-12">
      {/* Main Content: Post Grid */}
      <div class="flex-1 flex flex-col min-h-[500px]">
        {paginatedPosts.length > 0 ? (
          <>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 flex-1 content-start">
              {paginatedPosts.map((post) => (
                <BlogCard post={post} />
              ))}
            </div>
            
            {/* Pagination Controls */}
            {totalPages > 1 && (
              <div class="flex items-center justify-center gap-4 mt-12">
                {prevPageUrl ? (
                  <a
                    href={prevPageUrl}
                    class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2"
                  >
                    Sebelumnya
                  </a>
                ) : (
                  <button disabled class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors border border-input bg-background h-9 px-4 py-2 opacity-50 cursor-not-allowed">
                    Sebelumnya
                  </button>
                )}
                
                <span class="text-sm font-medium text-muted-foreground">
                  Halaman {currentPage} dari {totalPages}
                </span>

                {nextPageUrl ? (
                  <a
                    href={nextPageUrl}
                    class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2"
                  >
                    Berikutnya
                  </a>
                ) : (
                  <button disabled class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors border border-input bg-background h-9 px-4 py-2 opacity-50 cursor-not-allowed">
                    Berikutnya
                  </button>
                )}
              </div>
            )}
          </>
        ) : (
          <div class="py-16 text-center text-muted-foreground border border-dashed border-border rounded-2xl flex-1 flex items-center justify-center">
            Tidak ada postingan.
          </div>
        )}
      </div>

      {/* Sidebar Modular (Kategori, Tags, Sort Filter dgn shadcn) */}
      <BlogSidebar 
        categories={categories} 
        tags={tags} 
        sortBy={sortBy} 
        startDate={startDate}
        endDate={endDate}
      />
    </div>
  </div>
</BaseLayout>
