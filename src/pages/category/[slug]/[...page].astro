---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogCard from "@/components/BlogCard.astro";
import BlogSidebar from "@/components/BlogSidebar.astro";
import { getCategories, getTags, getPosts } from "@/lib/api/blog";
import { ArrowLeft, ChevronRight } from "lucide-react";
import { Button } from "@/components/ui/button";

const { slug, page } = Astro.params;

if (!slug) {
  return Astro.rewrite('/404');
}

const currentPage = page ? parseInt(page as string, 10) : 1;
if (isNaN(currentPage) || currentPage < 1) {
  return Astro.rewrite("/404");
}

const categories = await getCategories();
const currentCategory = categories.find(cat => cat.slug === slug);

if (!currentCategory) {
  return Astro.rewrite('/404');
}

const PAGE_SIZE = 10;
const startDate = Astro.url.searchParams.get('startDate') || undefined;
const endDate = Astro.url.searchParams.get('endDate') || undefined;
const sortBy = Astro.url.searchParams.get('sort') || 'Terbaru';

const { data: paginatedPosts, totalCount } = await getPosts({
  page: currentPage,
  limit: PAGE_SIZE,
  startDate,
  endDate,
  sort: sortBy,
  categorySlug: slug
});

const totalPages = Math.ceil(totalCount / PAGE_SIZE);

if (currentPage > totalPages && totalPages > 0) {
  return Astro.rewrite("/404");
}

const tags = await getTags();

const params = new URLSearchParams(Astro.url.searchParams);
const queryString = params.toString() ? `?${params.toString()}` : '';

const prevPageUrl = currentPage > 1 ? (currentPage === 2 ? `/category/${slug}${queryString}` : `/category/${slug}/${currentPage - 1}${queryString}`) : null;
const nextPageUrl = currentPage < totalPages ? `/category/${slug}/${currentPage + 1}${queryString}` : null;
---

<BaseLayout
  title={`${currentCategory.name} - Halaman ${currentPage} | Post Informatics Laboratory`}
  description={`Artikel dan pengumuman terkategori "${currentCategory.name}" dari Informatics Laboratory.`}
>
  <div class="container mx-auto max-w-7xl px-4 sm:px-6 py-12 md:py-20">
    <div class="mb-12">
      <a href="/post" class="inline-block mb-8">
        <Button variant="outline" className="px-6 font-semibold">
          <ArrowLeft className="w-4 h-4 mr-2" />
          Kembali ke Post
        </Button>
      </a>

      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4 text-foreground">
        Kategori: {currentCategory.name}
      </h1>
      <p class="text-lg text-muted-foreground max-w-2xl">
        Tampilkan semua artikel dalam kategori "{currentCategory.name}"
      </p>
    </div>

    <div class="flex flex-col lg:flex-row gap-12">
      <div class="flex-1 flex flex-col min-h-[500px]">
        {paginatedPosts.length > 0 ? (
          <>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 flex-1 content-start">
              {paginatedPosts.map((post) => (
                <BlogCard post={post} />
              ))}
            </div>
            
            {totalPages > 1 && (
              <div class="flex items-center justify-center gap-4 mt-12">
                {prevPageUrl ? (
                  <a href={prevPageUrl} class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2">
                    Sebelumnya
                  </a>
                ) : (
                  <button disabled class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors border border-input bg-background h-9 px-4 py-2 opacity-50 cursor-not-allowed">
                    Sebelumnya
                  </button>
                )}
                
                <span class="text-sm font-medium text-muted-foreground">
                  Halaman {currentPage} dari {totalPages}
                </span>

                {nextPageUrl ? (
                  <a href={nextPageUrl} class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2">
                    Berikutnya
                  </a>
                ) : (
                  <button disabled class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors border border-input bg-background h-9 px-4 py-2 opacity-50 cursor-not-allowed">
                    Berikutnya
                  </button>
                )}
              </div>
            )}
          </>
        ) : (
          <div class="py-16 text-center text-muted-foreground border border-dashed border-border rounded-2xl flex-1 flex items-center justify-center">
            Tidak ada postingan dalam kategori ini.
          </div>
        )}
      </div>

      <BlogSidebar 
        categories={categories} 
        tags={tags} 
        sortBy={sortBy} 
        currentCategorySlug={slug}
        startDate={startDate}
        endDate={endDate} 
      />
    </div>
  </div>
</BaseLayout>
