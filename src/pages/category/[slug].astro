---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PostsSection } from "@/components/PostsSection";
import { getCategories, getTags, getPostsByCategory } from "@/lib/api";
import { ArrowLeft } from "lucide-react";
import { Button } from "@/components/ui/button";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

// Get all categories to find the current one
const categories = await getCategories();
const currentCategory = categories.find(cat => cat.slug === slug);

if (!currentCategory) {
  return Astro.redirect('/404');
}

// Get posts for this category
const posts = await getPostsByCategory(slug);
const tags = await getTags();
---

<BaseLayout
  title={`${currentCategory.name} | Post Laboratorium Informatika`}
  description={`Artikel dan pengumuman terkategori "${currentCategory.name}" dari Laboratorium Informatika.`}
>
  <div class="container mx-auto max-w-7xl px-4 sm:px-6 py-12 md:py-20">
    <div class="mb-12">
      <a href="/post" class="inline-block mb-8">
        <Button variant="outline" className="px-6 font-semibold">
          <ArrowLeft className="w-4 h-4 mr-2" />
          Kembali ke Post
        </Button>
      </a>

      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4 text-foreground">
        Kategori: {currentCategory.name}
      </h1>
      <p class="text-lg text-muted-foreground max-w-2xl">
        Tampilkan semua artikel dalam kategori "{currentCategory.name}"
      </p>
    </div>

    <PostsSection posts={posts} categories={categories} tags={tags} client:load />
  </div>
</BaseLayout>
