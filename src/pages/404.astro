---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
---

<BaseLayout
  title="404 - Halaman Tidak Ditemukan | Informatics Laboratory"
  description="Halaman yang Anda cari tidak dapat ditemukan atau telah dipindahkan."
>
  <div class="w-full flex flex-col flex-1 justify-center">
    <section class="container mx-auto max-w-7xl px-4 sm:px-6 py-4 md:py-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-8 lg:gap-16 items-center">
        <div class="max-w-2xl order-2 lg:order-1">
          <h1 class="text-3xl font-bold tracking-tighter sm:text-5xl md:text-6xl lg:text-[4.5rem] leading-[1.1] text-foreground">
            EITSSS!!
          </h1>
          <p class="mt-4 md:mt-6 text-base md:text-lg leading-relaxed text-muted-foreground">
            Maaf, halaman yang Anda cari tidak ada. Mungkin salah ketik atau sudah dihapus.
          </p>
          <div class="mt-6 md:mt-8 flex flex-wrap gap-3 md:gap-4">
            <a href="/">
              <Button className="px-6 font-semibold">
                Kembali ke Beranda
              </Button>
            </a>
            <a href="/post">
              <Button variant="outline" className="px-6 font-semibold">
                Lihat Postingan
              </Button>
            </a>
          </div>
        </div>

        <div class="order-1 lg:order-2 flex items-center justify-center w-full">
          <img
            src="/404-notfound.svg"
            alt="Ilustrasi 404 Halaman Tidak Ditemukan"
            width="500"
            height="500"
            class="w-full max-w-lg h-auto object-contain"
          />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
