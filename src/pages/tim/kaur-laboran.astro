---
import BaseLayout from "@/layouts/BaseLayout.astro";

// Mock Data
const kaur = [
  { 
    name: "Dr. Ir. Budi Santoso, M.T.", 
    title: "Kepala Urusan Laboratorium", 
    image: "/kaur-laboran/pak-fariz.webp" 
  }
];

const laboran = [
  { name: "Ahmad Fauzi", title: "Laboran Senior", image: "/kaur-laboran/mbak-oku.webp" },
  { name: "Siti Rahmawati", title: "Laboran Jaringan", image: "/kaur-laboran/mbak-oku.webp" }
];
---
<style>
  /* Mobile (<768px): 1 kotak per baris (100%) */
  .pyramid-card {
    width: 100%;
  }
  
  /* Desktop (>=768px): 3 kotak per baris (33.33%) */
  @media (min-width: 768px) {
    .pyramid-card {
      width: calc(33.333333% - 1.333333rem); /* untuk md:gap-8 (2rem) */
    }
  }
</style>

<BaseLayout
  title="Kaur & Laboran | Laboratorium Informatika"
  description="Kepala Urusan dan Laboran Laboratorium Informatika."
>
  <div class="container mx-auto max-w-7xl px-4 sm:px-6 py-12 md:py-20">
    <div class="mb-16 text-center">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4 text-foreground">
        Kaur & Laboran
      </h1>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
        Kepala Urusan dan Laboran Laboratorium Informatika Telkom University
      </p>
    </div>

    <!-- Tier 1: Kepala Urusan (1 Orang, Puncak Piramida) -->
    <div class="flex flex-wrap justify-center gap-4 md:gap-8 mb-12">
      {kaur.map((person) => (
        <img 
          src={person.image} 
          alt={person.name} 
          class="pyramid-card rounded-xl md:rounded-2xl" 
        />
      ))}
    </div>

    <!-- Tier 2: Laboran (2 Orang, Kiri Kanan) -->
    <div class="flex flex-wrap justify-center gap-4 md:gap-8">
      {laboran.map((person) => (
        <img 
          src={person.image} 
          alt={person.name} 
          class="pyramid-card rounded-xl md:rounded-2xl" 
        />
      ))}
    </div>
  </div>
</BaseLayout>
