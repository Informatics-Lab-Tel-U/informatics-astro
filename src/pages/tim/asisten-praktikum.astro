---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { AsprakTable } from "@/components/AsprakTable";
import type { AsprakRow } from "@/components/AsprakTable";

export const prerender = false;

let asprakList: AsprakRow[] = [];
let availableTerms: string[] = [];
let fetchError: string | undefined = undefined;
let usedFallback = false;

const BACKEND_URL =
  import.meta.env.PUBLIC_HONO_BACKEND_URL ||
  "https://manajemenasprak-backend.iflabdev.workers.dev";

const INTERNAL_API_KEY = import.meta.env.INTERNAL_API_KEY || "";

const rawTerm = Astro.url.searchParams.get("term") || "all";
const termParam = /^[a-zA-Z0-9-]{1,10}$/.test(rawTerm) ? rawTerm : "all";

try {
  // Fetch available terms and asprak in parallel
  const [termsRes, asprakRes] = await Promise.all([
    fetch(`${BACKEND_URL}/api/asprak?action=terms`, {
      headers: { "x-api-key": INTERNAL_API_KEY },
    }),
    fetch(
      `${BACKEND_URL}/api/asprak${termParam !== "all" ? `?term=${encodeURIComponent(termParam)}` : ""}`,
      {
        headers: { "x-api-key": INTERNAL_API_KEY },
      }
    ),
  ]);

  if (termsRes.ok) {
    const termsJson = await termsRes.json();
    if (termsJson.ok && Array.isArray(termsJson.data)) {
      availableTerms = termsJson.data;
    }
  }

  if (asprakRes.ok) {
    const json = await asprakRes.json();
    if (json.ok && Array.isArray(json.data)) {
      asprakList = (json.data as any[])
        .filter((a) => a.role === "ASPRAK")
        .map((a) => ({
          id: String(a.id),
          nama_lengkap: a.nama_lengkap,
          kode: a.kode,
          angkatan: a.angkatan || 0,
          role: a.role,
        }));
    }
  } else {
    fetchError = `Error HTTP ${asprakRes.status}`;
  }
} catch (e: any) {
  fetchError = e.message;
}

if (asprakList.length === 0 && termParam === "all") {
  usedFallback = true;
  asprakList = [
    { id: "1", nama_lengkap: "[Nama Asprak]", kode: "AAA", angkatan: 2023, role: "ASPRAK" },
    { id: "2", nama_lengkap: "[Nama Asprak]", kode: "BBB", angkatan: 2023, role: "ASPRAK" },
    { id: "3", nama_lengkap: "[Nama Asprak]", kode: "CCC", angkatan: 2022, role: "ASPRAK" },
    { id: "4", nama_lengkap: "[Nama Asprak]", kode: "DDD", angkatan: 2022, role: "ASPRAK" },
  ];
}

// Sort: angkatan terbaru dulu, lalu nama A-Z
asprakList.sort(
  (a, b) => b.angkatan - a.angkatan || a.nama_lengkap.localeCompare(b.nama_lengkap)
);
---

<BaseLayout
  title="Asisten Praktikum | Informatics Laboratory"
  description="Daftar asisten praktikum yang terdaftar di Laboratorium Informatika Telkom University."
>
  <div class="container mx-auto max-w-7xl px-4 sm:px-6 py-12 md:py-20">
    <div class="mb-10 text-center">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-3 text-foreground">
        Asisten Praktikum
      </h1>
      <p class="text-lg text-muted-foreground">
        Asisten praktikum yang terdaftar di Laboratorium Informatika.
      </p>
    </div>

    {(fetchError || usedFallback) && (
      <div class="mb-6 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-800/40 dark:bg-amber-900/20 dark:text-amber-300">
        {fetchError
          ? `Gagal memuat data dari server (${fetchError}). Menampilkan data contoh.`
          : "Data belum tersedia dari server. Menampilkan data contoh."}
      </div>
    )}

    <AsprakTable
      client:load
      initialData={asprakList}
      availableTerms={availableTerms}
      initialTerm={termParam}
    />
  </div>
</BaseLayout>
