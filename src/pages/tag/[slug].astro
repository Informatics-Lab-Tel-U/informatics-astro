---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { BlogCard } from "@/components/BlogCard";
import { getTags, getPostsByTag } from "@/lib/api";
import { ArrowLeft } from "lucide-react";
import { Button } from "@/components/ui/button";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

// Get all tags to find the current one
const tags = await getTags();
const currentTag = tags.find(tag => tag.slug === slug);

if (!currentTag) {
  return Astro.redirect('/404');
}

// Get posts for this tag
const posts = await getPostsByTag(slug);
---

<BaseLayout
  title={`${currentTag.name} | Post Laboratorium Informatika`}
  description={`Artikel dan pengumuman dengan tag "${currentTag.name}" dari Laboratorium Informatika.`}
>
  <div class="container mx-auto max-w-7xl px-4 sm:px-6 py-12 md:py-20">
    <div class="mb-12">
      <a href="/post" class="inline-block mb-8">
        <Button variant="outline" className="px-6 font-semibold">
          <ArrowLeft className="w-4 h-4 mr-2" />
          Kembali ke Post
        </Button>
      </a>

      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4 text-foreground">
        Tag: #{currentTag.name}
      </h1>
      <p class="text-lg text-muted-foreground max-w-2xl">
        Tampilkan semua artikel dengan tag "{currentTag.name}"
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      {posts.length > 0 ? (
        posts.map((post) => (
          <BlogCard post={post} client:load />
        ))
      ) : (
        <div class="col-span-full text-center py-12">
          <p class="text-lg text-muted-foreground">Belum ada artikel dengan tag ini.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
