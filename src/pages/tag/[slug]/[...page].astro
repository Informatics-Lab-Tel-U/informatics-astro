---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogCard from "@/components/BlogCard.astro";
import { getCategories, getTags, getPostsByTag } from "@/lib/api";
import { ArrowLeft, ChevronRight } from "lucide-react";
import { Button } from "@/components/ui/button";

const { slug, page } = Astro.params;

if (!slug) {
  return Astro.rewrite('/404');
}

const currentPage = page ? parseInt(page as string, 10) : 1;
if (isNaN(currentPage) || currentPage < 1) {
  return Astro.rewrite("/404");
}

const tags = await getTags();
const currentTag = tags.find(tag => tag.slug === slug);

if (!currentTag) {
  return Astro.rewrite('/404');
}

const posts = await getPostsByTag(slug);
const categories = await getCategories();

const PAGE_SIZE = 9;
const totalPages = Math.ceil(posts.length / PAGE_SIZE);

if (currentPage > totalPages && totalPages > 0) {
  return Astro.rewrite("/404");
}

const startIndex = (currentPage - 1) * PAGE_SIZE;
const paginatedPosts = posts.slice(startIndex, startIndex + PAGE_SIZE);

const prevPageUrl = currentPage > 1 ? (currentPage === 2 ? `/tag/${slug}` : `/tag/${slug}/${currentPage - 1}`) : null;
const nextPageUrl = currentPage < totalPages ? `/tag/${slug}/${currentPage + 1}` : null;
---

<BaseLayout
  title={`#${currentTag.name} - Halaman ${currentPage} | Post Laboratorium Informatika`}
  description={`Artikel dan pengumuman dengan tag "${currentTag.name}" dari Laboratorium Informatika.`}
>
  <div class="container mx-auto max-w-7xl px-4 sm:px-6 py-12 md:py-20">
    <div class="mb-12">
      <a href="/post" class="inline-block mb-8">
        <Button variant="outline" className="px-6 font-semibold">
          <ArrowLeft className="w-4 h-4 mr-2" />
          Kembali ke Post
        </Button>
      </a>

      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4 text-foreground">
        Tag: #{currentTag.name}
      </h1>
      <p class="text-lg text-muted-foreground max-w-2xl">
        Tampilkan semua artikel dengan tag "{currentTag.name}"
      </p>
    </div>

    <div class="flex flex-col lg:flex-row gap-12">
      <div class="flex-1 flex flex-col min-h-[500px]">
        {paginatedPosts.length > 0 ? (
          <>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 flex-1 content-start">
              {paginatedPosts.map((post) => (
                <BlogCard post={post} />
              ))}
            </div>
            
            {totalPages > 1 && (
              <div class="flex items-center justify-center gap-4 mt-12 pt-8 border-t border-border">
                {prevPageUrl ? (
                  <a href={prevPageUrl} class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2">
                    Sebelumnya
                  </a>
                ) : (
                  <button disabled class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors border border-input bg-background h-9 px-4 py-2 opacity-50 cursor-not-allowed">
                    Sebelumnya
                  </button>
                )}
                
                <span class="text-sm font-medium text-muted-foreground">
                  Halaman {currentPage} dari {totalPages}
                </span>

                {nextPageUrl ? (
                  <a href={nextPageUrl} class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors border border-input bg-background hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2">
                    Berikutnya
                  </a>
                ) : (
                  <button disabled class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors border border-input bg-background h-9 px-4 py-2 opacity-50 cursor-not-allowed">
                    Berikutnya
                  </button>
                )}
              </div>
            )}
          </>
        ) : (
          <div class="py-16 text-center text-muted-foreground border border-dashed border-border rounded-2xl flex-1 flex items-center justify-center">
            Tidak ada postingan dengan tag ini.
          </div>
        )}
      </div>

      <aside class="w-full lg:w-80 flex-shrink-0 space-y-10">
        <div>
          <h3 class="text-lg font-semibold tracking-tight mb-4 border-b border-border pb-2 text-foreground">
            Kategori
          </h3>
          <ul class="space-y-2">
            {categories.map((cat) => (
              <li>
                <a href={`/category/${cat.slug}`} class="text-foreground/80 hover:text-primary transition-colors flex items-center justify-between group">
                  <span>{cat.name}</span>
                  <ChevronRight className="h-4 w-4 text-muted-foreground group-hover:text-primary transition-colors" />
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="text-lg font-semibold tracking-tight mb-4 border-b border-border pb-2 text-foreground">
            Topik Populer (Tags)
          </h3>
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <a href={`/tag/${tag.slug}`} class="text-xs font-medium text-foreground/80 bg-secondary/30 hover:bg-secondary/60 hover:text-foreground transition-colors px-3 py-1.5 rounded-md border border-transparent">
                <span class={tag.slug === slug ? "font-bold text-primary" : ""}>#{tag.name}</span>
              </a>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
