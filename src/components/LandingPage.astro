---
import { Button } from "@/components/ui/button";
import BlogCard from "@/components/BlogCard.astro";
import type { BlogPost } from "@/lib/api";

interface Props {
  recentPosts?: BlogPost[];
}

const { recentPosts = [] } = Astro.props;
---

<div class="w-full flex flex-col">
  {/* Hero Section (Text) - Wide container for impact */}
  <section class="container-wide pt-20 pb-12 md:pt-32 md:pb-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 items-center">
      <div>
        <h1 class="text-4xl font-bold tracking-tighter sm:text-5xl md:text-6xl lg:text-[5rem] leading-[1.1] text-foreground">
          Informatics Laboratory
        </h1>
      </div>
      <div class="flex flex-col items-start text-left">
        <p class="text-lg leading-relaxed text-muted-foreground">
          Website ini akan digunakan untuk mengumumkan semua informasi resmi dari IFLab mulai dari pengumuman jadwal pengganti, peraturan praktikum hingga pengumuman terkait tugas pendahuluan.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/tentang">
            <Button className="px-6 font-semibold">Tentang Kami</Button>
          </a>
          <a href="/post">
            <Button variant="outline" className="px-6 font-semibold">Feedback Praktikum</Button>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Hero Section (Image Container) - Full-bleed with max-width constraint and wider aspect ratio */}
  <section class="w-full px-4 sm:px-6 pb-20 md:pb-32">
    <div class="mx-auto max-w-[1600px]">
      <div class="relative aspect-[21/9] w-full overflow-hidden rounded-3xl bg-muted/30 border border-border">
        <img
          src="/default-image.svg"
          alt="Hero Showcase"
          width="2100"
          height="900"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  {/* Layanan dan Feedback Section - Content container for balanced text readability */}
  <section class="bg-background py-24 md:py-32">
    <div class="container-content">
      <div class="mb-16 text-center max-w-2xl mx-auto">
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl md:text-5xl mb-4">Layanan & Feedback</h2>
        <p class="text-lg text-muted-foreground">
          Platform lengkap untuk informasi praktikum dan sarana komunikasi dengan laboratorium.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x border border-border rounded-3xl overflow-hidden bg-background">
        {/* Layanan Card */}
        <div class="p-10 md:p-14 flex flex-col hover:bg-muted/30 transition-colors duration-500">
          <div class="mb-6 flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary text-sm font-semibold">
            01
          </div>
          <h3 class="text-xl font-semibold tracking-tight mb-4 text-foreground">Layanan Informasi</h3>
          <p class="text-muted-foreground leading-relaxed text-[15px] sm:text-base">
            Website Laboratorium Praktikum Informatika Telkom University memiliki fungsionalitas untuk memberikan informasi seputar nilai praktikum dan jadwal praktikum yang akan berlangsung kepada semua warga Informatics Laboratory.
          </p>
        </div>

        {/* Feedback Card */}
        <div class="p-10 md:p-14 flex flex-col hover:bg-muted/30 transition-colors duration-500">
          <div class="mb-6 flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary text-sm font-semibold">
            02
          </div>
          <h3 class="text-xl font-semibold tracking-tight mb-4 text-foreground">Layanan Feedback</h3>
          <p class="text-muted-foreground leading-relaxed text-[15px] sm:text-base">
            Layanan feedback ini dibuat sebagai sarana untuk menyampaikan keluhan atau berdiskusi untuk memajukan Informatics Laboratory. Untuk melakukan pengisian feedback wajib menggunakan akun SSO Telkom University terlebih dahulu.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Announcements & Tasks Section - Wide container to match hero, optimal for 3-col grid */}
  <section class="container-wide py-24 md:py-32">
    <div class="mb-16 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl md:text-5xl mb-4">Pengumuman & Tugas</h2>
        <p class="text-lg text-muted-foreground">Informasi terbaru terkait kegiatan praktikum dan akademik.</p>
      </div>
      <a href="/post" class="shrink-0">
        <Button variant="outline" className="px-6 font-semibold">Lihat Semua</Button>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {recentPosts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>
  </section>
</div>
