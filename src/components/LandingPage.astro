---
import { Button } from "@/components/ui/button";
import BlogCard from "@/components/BlogCard.astro";
import HeroSlider, { type HeroImageSlide } from "@/components/HeroSlider";
import HeroFlipTitle from "@/components/HeroFlipTitle";
import type { BlogPost } from "@/lib/api/blog";

interface Props {
  recentPosts?: BlogPost[];
  heroImages?: HeroImageSlide[];
  heroTitles?: { line1: string; line2: string }[];
}

const { recentPosts = [], heroImages = [], heroTitles = [] } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "Laboratorium Informatika Telkom University",
  "alternateName": "Telkom University",
  "url": "https://iflab.web.id/",
  "logo": "https://iflab.web.id/favicon.svg",
  "contactPoint": {
    "@type": "ContactPoint",
    "email": "informaticslab@telkomuniversity.ac.id",
    "contactType": "customer support"
  }
};
---

<div class="w-full flex flex-col">
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  {/* Hero Section - Combined Layout */}
  <section class="relative w-full min-h-[100svh] flex flex-col justify-center md:min-h-0 md:block">
    
    {/* Text Content */}
    <div class="container-wide relative z-10 pt-28 pb-16 md:pt-32 md:pb-16">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 items-center">
        <div>
          <h1 class="text-4xl font-bold tracking-tighter sm:text-5xl md:text-6xl lg:text-[5rem] leading-[1.1] text-foreground">
            <HeroFlipTitle pairs={heroTitles} client:load />
          </h1>
        </div>
        <div class="flex flex-col items-start text-left">
          <p class="text-lg leading-relaxed text-foreground md:text-muted-foreground font-medium md:font-normal">
            Informasi jadwal praktikum, modul, tugas pendahuluan, pengumuman, dan kegiatan praktikum bagi mahasiswa.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/tentang">
              <Button className="px-6 font-semibold">Tentang Kami</Button>
            </a>
            <a href="/post">
              <Button variant="outline" className="px-6 font-semibold bg-background/80 backdrop-blur-sm hover:bg-background/90 md:bg-transparent md:backdrop-blur-none border-primary/20 md:border-input">Feedback Praktikum</Button>
            </a>
          </div>
        </div>
      </div>
    </div>

    {/* Background Image (Mobile) / Card Image (Desktop) */}
    <div class="absolute inset-0 z-0 w-full h-full md:relative md:w-full md:h-auto md:px-4 sm:px-6 md:pb-20 md:mx-auto md:max-w-[1600px]">
      <HeroSlider slides={heroImages} client:load />
    </div>
  </section>

  {/* Layanan dan Feedback Section - Content container for balanced text readability */}
  <section class="bg-background py-24 md:py-32">
    <div class="container-content">
      <div class="mb-16 text-center max-w-2xl mx-auto">
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl md:text-5xl mb-4">Layanan & Feedback</h2>
        <p class="text-lg text-muted-foreground">
          Pusat informasi kegiatan praktikum dan saluran aspirasi mahasiswa.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x border border-border rounded-3xl overflow-hidden bg-background">
        {/* Layanan Card */}
        <div class="p-10 md:p-14 flex flex-col hover:bg-muted/30 transition-colors duration-500">
          <div class="mb-6 flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary text-sm font-semibold">
            01
          </div>
          <h3 class="text-xl font-semibold tracking-tight mb-4 text-foreground">Layanan Informasi</h3>
          <p class="text-muted-foreground leading-relaxed text-[15px] sm:text-base">
            Akses terpusat untuk jadwal praktikum, informasi kelas pengganti, publikasi nilai, dan panduan akademik praktikum Informatika.
          </p>
        </div>

        {/* Feedback Card */}
        <div class="p-10 md:p-14 flex flex-col hover:bg-muted/30 transition-colors duration-500">
          <div class="mb-6 flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary text-sm font-semibold">
            02
          </div>
          <h3 class="text-xl font-semibold tracking-tight mb-4 text-foreground">Layanan Feedback</h3>
          <p class="text-muted-foreground leading-relaxed text-[15px] sm:text-base">
            Saluran komunikasi resmi bagi mahasiswa untuk menyampaikan masukan, saran, dan evaluasi pelaksanaan praktikum melalui akun SSO Telkom University.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Announcements & Tasks Section - Wide container to match hero, optimal for 3-col grid */}
  <section class="container-wide py-24 md:py-32">
    <div class="mb-16 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
      <div class="max-w-2xl">
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl md:text-5xl mb-4">Pengumuman & Tugas</h2>
        <p class="text-lg text-muted-foreground">Informasi terbaru terkait kegiatan praktikum dan akademik.</p>
      </div>
      <a href="/post" class="shrink-0">
        <Button variant="outline" className="px-6 font-semibold">Lihat Semua</Button>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {recentPosts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>
  </section>
</div>
