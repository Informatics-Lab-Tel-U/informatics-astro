---
import { Image } from "astro:assets";
import type { BlogPost } from "@/lib/api";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

// Format the date (e.g., 20 Jul 2026)
const formattedDate = new Date(post.pubDate).toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'short',
  year: 'numeric'
});
---

<a href={`/post/${post.slug}`} class="block group h-full">
  <div class="flex flex-col h-full overflow-hidden rounded-3xl border border-border shadow-none group-hover:border-primary/20 transition-colors duration-300 bg-background p-0 gap-0 cursor-pointer">
    <div class="aspect-video w-full bg-muted rounded-t-3xl overflow-hidden relative">
      <Image
        src={post.heroImage || "/default-image.svg"}
        alt={post.title}
        width={800}
        height={450}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    </div>
    <div class="flex-1 px-6 pt-4 pb-2">
      <div class="flex items-center justify-between gap-2 mb-3">
        <div class="inline-flex items-center border border-transparent bg-secondary text-secondary-foreground hover:bg-secondary/80 rounded-md px-2.5 py-0.5 text-xs font-medium focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2">
          {post.category.name}
        </div>
        <span class="text-xs text-muted-foreground">{formattedDate}</span>
      </div>
      <h3 class="line-clamp-2 text-xl font-semibold tracking-tight text-foreground group-hover:text-primary transition-colors">
        {post.title}
      </h3>
      <p class="line-clamp-3 mt-2 text-muted-foreground text-[15px] leading-relaxed">
        {post.description}
      </p>
    </div>
    <div class="px-6 pb-6 pt-0 mt-auto flex flex-wrap gap-2 items-center">
      {post.tags && post.tags.length > 0 ? (
        post.tags.map((tag) => (
          <div
            class="inline-flex items-center border hover:bg-accent hover:text-accent-foreground rounded-md px-2 py-0.5 text-xs font-medium text-muted-foreground bg-muted/50 border-transparent focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
          >
            {tag.name}
          </div>
        ))
      ) : null}
    </div>
  </div>
</a>
